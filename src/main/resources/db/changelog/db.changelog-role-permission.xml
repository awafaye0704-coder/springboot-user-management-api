<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-role-permission-table" author="awa">

        <createTable tableName="RolePermission">

            <column name="RoleId" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="Permission" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="RolePermission"
                baseColumnNames="RoleId"
                referencedTableName="Role"
                referencedColumnNames="RoleId"
                constraintName="FK_ROLE_PERMISSION"/>

    </changeSet>

</databaseChangeLog>