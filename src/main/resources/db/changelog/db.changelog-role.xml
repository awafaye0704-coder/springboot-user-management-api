<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-role-table" author="awa">

        <createTable tableName="Role">

            <column name="RoleId" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"/>
            </column>

            <column name="RoleName" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="RoleDescription" type="VARCHAR(500)"/>

            <column name="ExternalReference" type="VARCHAR(255)"/>

            <column name="RoleCreationDate" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="RoleModificationDate" type="TIMESTAMP"/>

        </createTable>

    </changeSet>

</databaseChangeLog>